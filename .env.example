# ---------------------------------------------------------------------------
# Project Quartermaster — environment configuration (v0.1.0)
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quartermaster?schema=public"

# Telegram bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN="123456:replace-with-your-telegram-bot-token"

# Numeric Telegram ID of the first administrator.
# Used by the seed script (npm run db:seed) to create the admin account.
# Get yours by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_ID="123456789"

# Display name stored for the seeded admin account.
ADMIN_FULL_NAME="ASE Administrator"

# Runtime environment: development | production
NODE_ENV="development"
