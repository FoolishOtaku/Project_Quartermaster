{
  "name": "project-quartermaster",
  "version": "0.2.2",
  "description": "Telegram-based inventory management bot for the ASE Software Engineering Laboratory (v0.2.2: one-command quickstart).",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "setup": "npm run prisma:generate && npm run prisma:deploy && npm run db:seed",
    "quickstart": "npm run setup && npm run start:dev",
    "quickstart:win": "powershell -ExecutionPolicy Bypass -File scripts/quickstart.ps1",
    "quickstart:sh": "bash scripts/quickstart.sh",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@prisma/client": "^5.22.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "nestjs-telegraf": "2.9.1",
    "pino": "^10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.2",
    "eslint": "^10.6.0",
    "jest": "29.7.0",
    "prettier": "^3.9.4",
    "prisma": "^5.22.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoolishOtaku/Project_Quartermaster.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FoolishOtaku/Project_Quartermaster/issues"
  },
  "homepage": "https://github.com/FoolishOtaku/Project_Quartermaster#readme"
}
